# Documentation only: these files are NOT loaded automatically by the Worker.
# Use the hosting provider's server-side secrets/settings. Never commit values.
OWNER_USER_ID=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Optional JSON array of exact calendar URLs returned by list_calendars.
# Unset: discovered account calendars; []: deny every calendar.
CALDAV_ALLOWED_CALENDAR_URLS=
# Optional JSON array of independently verified exact pNN-caldav.icloud.com.cn hosts.
# Default [] denies all regional hosts. Do not copy fixture hosts into deployment.
CALDAV_ALLOWED_REGIONAL_HOSTS=[]
# Literal true only after owner approval and successful read-only acceptance.
WRITE_ENABLED=false
